meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Barbeiro Um",
    "email": "barbeiro.um@e2e.dev",
    "password": "senha123",
    "role": "BARBER",
    "tenantId": "{{tenantId}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

script:post-response {
  if (res.body.id) {
    bru.setVar("userId", res.body.id);
  }
}
