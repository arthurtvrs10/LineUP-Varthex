# Copie este arquivo para .env.local (na pasta frontend/) e preencha os
# valores. .env.local é ignorado pelo git — nunca commite credenciais reais.

# Credenciais do Google Cloud Console (OAuth 2.0 Client ID), usadas pelo
# botão "Entrar com Google". Sem isso o login por e-mail/senha continua
# funcionando normalmente — só o login social fica indisponível.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gere um valor com: openssl rand -base64 32
# Obrigatório — o NextAuth usa isso para assinar/criptografar a sessão.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8080

# Resend (resend.com) — usado só pelo backend, pra envio de e-mail
# transacional (recuperação de senha). Sem domínio verificado, o
# remetente precisa ficar em onboarding@resend.dev e só entrega pro
# próprio e-mail da conta Resend (limite do modo sandbox). Se deixar em
# branco, o resto do app funciona normalmente — só "esqueci minha senha"
# fica indisponível.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
