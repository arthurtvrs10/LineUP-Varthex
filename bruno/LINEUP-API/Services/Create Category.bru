meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/service-categories
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Cortes",
    "sortOrder": 0,
    "active": true,
    "version": 0
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

script:post-response {
  if (res.body.id) {
    bru.setVar("categoryId", res.body.id);
  }
}
