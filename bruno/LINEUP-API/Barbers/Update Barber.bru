meta {
  name: Update Barber
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/barbers/{{barberId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "bio": "Especialista em cortes clássicos e barba",
    "defaultCommissionPercent": 45
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}
