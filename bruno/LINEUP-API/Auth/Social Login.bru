meta {
  name: Social Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/social-login
  body: json
  auth: none
}

body:json {
  {
    "idToken": "<id_token real emitido pelo Google — obtido via NextAuth no frontend>"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

script:post-response {
  if (res.body.accessToken) {
    bru.setVar("accessToken", res.body.accessToken);
  }
}
