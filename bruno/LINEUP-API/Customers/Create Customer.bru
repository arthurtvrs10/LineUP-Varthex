meta {
  name: Create Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/customers
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "fullName": "Cliente Real",
    "email": "cliente@real.dev",
    "version": 0
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

script:post-response {
  if (res.body.id) {
    bru.setVar("customerId", res.body.id);
  }
}
