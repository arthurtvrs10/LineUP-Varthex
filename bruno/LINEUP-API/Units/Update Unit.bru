meta {
  name: Update Unit
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/unit
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Unidade Principal — Reformada",
    "street": "Rua das Tesouras",
    "number": "123",
    "district": "Centro",
    "city": "São Paulo",
    "state": "SP",
    "country": "BR",
    "timeZone": "America/Sao_Paulo",
    "active": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}
