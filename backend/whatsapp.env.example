# Copy these values into backend/.env.local (ignored by Git).
# Generate 32 random bytes and encode in Base64. Keep a backed-up, stable key.
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_GRAPH_VERSION=v23.0
# Public HTTPS origin serving /integrations/whatsapp/webhook.
WHATSAPP_PUBLIC_URL=
# Configure the reviewed Meta application to enable Embedded Signup.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WORKER_ENABLED=true
