# Load into the backend environment; do not put these values in NEXT_PUBLIC variables.
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Separate secret, 32–255 characters, matching the configured Asaas webhook authToken.
ASAAS_WEBHOOK_TOKEN=
ASAAS_GRACE_DAYS=3
ASAAS_WORKER_ENABLED=true
# Only for sandbox: enables simulated Pix confirmation in the checkout.
# The server rejects this action in production even if this flag is true.
ASAAS_SANDBOX_ACTIONS_ENABLED=false
FRONTEND_URL=http://localhost:3000
# Optional billing e-mail notices use the existing Resend integration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
