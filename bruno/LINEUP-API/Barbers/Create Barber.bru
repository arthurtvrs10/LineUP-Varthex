meta {
  name: Create Barber
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/barbers
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "userId": "{{userId}}",
    "unitId": "{{unitId}}",
    "displayName": "Barbeiro Um",
    "bio": "Especialista em cortes clássicos",
    "defaultCommissionPercent": 40
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

script:post-response {
  if (res.body.id) {
    bru.setVar("barberId", res.body.id);
  }
}
